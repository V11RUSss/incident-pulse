# Режим: auto | api | vllm. ./start.sh --mode=... переопределяет.
AI_MODE=auto
# Движок для vllm: auto | nvidia | intel | cpu
AI_ENGINE=auto

# Классический API: deepseek | openai | custom.
# deepseek/openai подставляют base URL и модель автоматически.
AI_PROVIDER=custom
# Для custom: любой OpenAI-совместимый endpoint, обычно с /v1.
# DeepSeek: https://api.deepseek.com + deepseek-chat
# OpenAI:  https://api.openai.com/v1 + gpt-4o-mini
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=700

# Для gated-моделей и офлайн-режима:
# HF_TOKEN=
# MODEL_SKIP_DOWNLOAD=0

AI_FALLBACK=true
AI_RATE_LIMIT_PER_MIN=10
ASSISTANT_ENABLED=true
ASSISTANT_RATE_LIMIT_PER_MIN=20

# Подсказки команды в карточке и очередь маршрутизации.
ROUTING_ENABLED=true
ROUTING_RATE_LIMIT_PER_MIN=30
ROUTING_TIMEOUT_MS=20000

# Постмортем по истории изменений.
POSTMORTEM_ENABLED=true
POSTMORTEM_RATE_LIMIT_PER_MIN=10
POSTMORTEM_TIMEOUT_MS=60000

# Линтер качества: детерминированные правила + AI semantic scan.
# Демо-генератор: по умолчанию включён для локальной демонстрации.
# В production обязательно DEMO_GENERATION=false.
DEMO_GENERATION=true
DEMO_MIN_INTERVAL_MS=3000
DEMO_MAX_INTERVAL_MS=9000
DEMO_BATCH_MIN=1
DEMO_BATCH_MAX=3
DEMO_MAX_ACTIVE=20


# Семантический триаж: кандидаты на склейку и correlationKey.
TRIAGE_ENABLED=true
TRIAGE_AI_ENABLED=true
TRIAGE_AI_RATE_LIMIT_PER_MIN=10
TRIAGE_AI_TIMEOUT_MS=20000

# Регистрация: для production выключите и создайте администратора
#   ADMIN_PASSWORD='...' node scripts/create-admin.js --login admin --name "Админ"
# Для локальной демонстрации можно включить true; в production оставьте false.
REGISTRATION_ENABLED=false
# Если задан — при регистрации обязателен registrationToken (для закрытого пилота).
REGISTRATION_TOKEN=

# Сеть: mock не выставляйте наружу. За reverse proxy задайте bind на 127.0.0.1.
APP_BIND=0.0.0.0
APP_HOST_PORT=8080
MOCK_BIND=127.0.0.1
MOCK_HOST_PORT=8081

# TLS/reverse proxy: PUBLIC_ORIGIN=https://pulse.example.com, COOKIE_SECURE=true
PUBLIC_ORIGIN=
COOKIE_SECURE=false
SESSION_TTL_MS=604800000
MAX_SSE_CLIENTS=500
